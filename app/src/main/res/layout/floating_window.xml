<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="400dp"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:padding="8dp"
    android:elevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2A2A2A"
        android:padding="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Monolith Agent"
            android:textColor="#00FF00"
            android:textStyle="bold"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnCloseFloating"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close_custom"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollViewFloating"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/chatContainerFloating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2A2A2A"
        android:padding="4dp">

        <EditText
            android:id="@+id/etFloatingMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="اكتب أمراً..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:imeOptions="actionSend" />

        <ImageButton
            android:id="@+id/btnSendFloating"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_send"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#00FF00" />
    </LinearLayout>
</LinearLayout>

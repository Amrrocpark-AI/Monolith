
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#09080F"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MONOLITH WALLPAPERS"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <ImageView
            android:id="@+id/btnWallpaperSearch"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            android:tint="#FFFFFF"
            android:contentDescription="Search" />

        <ImageView
            android:id="@+id/btnWallpaperSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            android:tint="#FFFFFF"
            android:contentDescription="Settings" />

    </LinearLayout>

    <!-- MAIN NAVIGATION -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabExplore"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:background="@drawable/bg_circle_dark"
                android:text="Explore"
                android:textColor="#C58AFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabCategories"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Categories"
                android:textColor="#AAAAAA" />

            <TextView
                android:id="@+id/tabFavorites"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Favorites"
                android:textColor="#AAAAAA" />

            <TextView
                android:id="@+id/tabMyWallpapers"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="My Wallpapers"
                android:textColor="#AAAAAA" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- VISUAL KEYWORD CARDS -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:text="Discover by Keywords"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/keywordCardsRecycler"
        android:layout_width="match_parent"
        android:layout_height="142dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="6dp" />

    <!-- DIMENSION SELECTOR -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/wallpaperDimensionContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- VALUES OF SELECTED DIMENSION -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/wallpaperCategoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    </HorizontalScrollView>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:text="Featured Collections"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/featuredWallpaperRecycler"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never" />

    <!-- GALLERY HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Explore Wallpapers"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWallpaperResultCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 wallpapers"
            android:textColor="#9B91A8"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- MAIN WALLPAPER GRID -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wallpaperGalleryRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/wallpaperEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦"
                android:textColor="#B66BFF"
                android:textSize="46sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your Wallpaper Gallery"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Your collection will appear here. Add wallpapers to start building your personal gallery."
                android:textColor="#9993A3"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>

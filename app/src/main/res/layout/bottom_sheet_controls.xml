<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="التحكم في العقل"
        android:textColor="#00FF00"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="درجة الإبداع (Temperature)"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <SeekBar
        android:id="@+id/sbTemperature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="70"
        android:progressTint="#00FF00" />

    <TextView
        android:id="@+id/tvTemperatureValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.7"
        android:textColor="#00FF00"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="نمط الشخصية"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/spinnerPersona"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#00FF00" />

    <CheckBox
        android:id="@+id/cbThinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تفعيل التفكير الداخلي (Inner Monologue)"
        android:textColor="#FFFFFF"
        android:buttonTint="#00FF00"
        android:checked="true"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSaveControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="حفظ الإعدادات"
        android:backgroundTint="#00FF00"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>

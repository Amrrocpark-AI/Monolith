<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- الشريط العلوي (نفس تصميم أداة التشتت) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnCloseSurgical"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close" />

        <ImageButton
            android:id="@+id/btnUndoSurgical"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/btnRedoSurgical"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_redo" />

        <!-- زر الممحاة الجراحية -->
        <ImageButton
            android:id="@+id/btnEraserSurgical"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_eraser" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnApplySurgical"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="تطبيق"
            android:textColor="#26A69A" />

        <Button
            android:id="@+id/btnSaveSurgical"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="حفظ"
            android:textColor="#00E5FF" />
    </LinearLayout>

    <!-- منطقة الصورة والقناع -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- الصورة الأصلية -->
        <ImageView
            android:id="@+id/ivSurgicalImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <!-- طبقة الرسم الجراحي (التي سنكتب كودها في الخطوة القادمة) -->
        <com.monolith.SurgicalMaskView
            android:id="@+id/surgicalMaskView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- زر اختيار الصورة (يختفي بعد الاختيار) -->
        <Button
            android:id="@+id/btnPickSurgicalImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:backgroundTint="#00E5FF"
            android:text="اختر صورة للتحديد"
            android:textColor="#000000" />
    </FrameLayout>

    <!-- اللوحة السفلية (نفس تصميم أداة التشتت) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvSurgicalLabel"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="الحجم"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBarSurgical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF" />

            <TextView
                android:id="@+id/tvSurgicalValue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="50"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- مكان أيقونات الأدوات (سنضيفها لاحقاً) -->
        <LinearLayout
            android:id="@+id/surgicalToolsRow"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>

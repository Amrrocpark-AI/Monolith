<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ========================================== -->
        <!-- قسم تخصيص شريط التحديد (الجديد) -->
        <!-- ========================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تخصيص شريط التحديد"
            android:textColor="#00D4FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="التحكم في ألوان وأشكال أزرار الحذف والنقل"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <!-- اختيار لون النيون -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لون النيون:"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgNeonColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            
            <RadioButton
                android:id="@+id/rbNeonBlue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أزرق"
                android:textColor="#FFFFFF"
                android:buttonTint="#00D4FF"
                android:checked="true"
                android:layout_marginEnd="16dp"/>
                
            <RadioButton
                android:id="@+id/rbNeonPink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="وردي"
                android:textColor="#FFFFFF"
                android:buttonTint="#FF00FF"
                android:layout_marginEnd="16dp"/>
                
            <RadioButton
                android:id="@+id/rbNeonGreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أخضر"
                android:textColor="#FFFFFF"
                android:buttonTint="#00FF00" />
        </RadioGroup>

        <!-- اختيار شكل الحواف -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="شكل الحواف:"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgFrameStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbStyleCyber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حاد (سيبراني)"
                android:textColor="#FFFFFF"
                android:buttonTint="#00D4FF"
                android:checked="true"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/rbStyleRounded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="دائري (كلاسيكي)"
                android:textColor="#FFFFFF"
                android:buttonTint="#00D4FF" />
        </RadioGroup>

        <!-- زر حفظ التخصيص -->
        <Button
            android:id="@+id/btnSaveSelectionStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ تخصيص شريط التحديد"
            android:backgroundTint="#00D4FF"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <!-- خط فاصل -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="32dp" />

        <!-- ========================================== -->
        <!-- إعدادات التطبيق السابقة (اللغة، الخلفية، الألوان) -->
        <!-- ========================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إعدادات مونوليث"
            android:textColor="#00D4FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- قسم اللغة -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لغة التطبيق"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/languageSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#00D4FF" />

        <Button
            android:id="@+id/btnApplyLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="تطبيق اللغة"
            android:backgroundTint="#00D4FF"
            android:textColor="#000000" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp" />

        <!-- قسم الخلفية -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="خلفية التطبيق"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/backgroundGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="داكن (افتراضي)"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="فاتح (أبيض)"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbCyber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="سايبربانك (أخضر)"
                android:textColor="#00FF00" />
        </RadioGroup>

        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="اختيار صورة من المعرض"
            android:backgroundTint="#2A2A2A"
            android:textColor="#00FF00" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp" />

        <!-- قسم لون التطبيق الرئيسي -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لون التطبيق الرئيسي"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الأحمر (Red)"
            android:textColor="#FF4444"
            android:layout_marginTop="8dp"/>
        <SeekBar
            android:id="@+id/sbRed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="0"
            android:progressTint="#FF4444" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الأخضر (Green)"
            android:textColor="#00FF00" />
        <SeekBar
            android:id="@+id/sbGreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="255"
            android:progressTint="#00FF00" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الأزرق (Blue)"
            android:textColor="#4444FF" />
        <SeekBar
            android:id="@+id/sbBlue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="0"
            android:progressTint="#4444FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="معاينة اللون:"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />

        <View
            android:id="@+id/viewColorPreview"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#00FF00"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ اللون وتطبيقه"
            android:backgroundTint="#00FF00"
            android:textColor="#000000"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>

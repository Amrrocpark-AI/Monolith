<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إعدادات المحرك الذكي"
            android:textColor="#00D4FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <Spinner
            android:id="@+id/providerSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#00D4FF" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="gsk_..."
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:inputType="textPassword"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnTestAndSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختبار وحفظ المفتاح"
            android:backgroundTint="#00D4FF"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تخصيص شريط التحديد"
            android:textColor="#00D4FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <RadioGroup
            android:id="@+id/rgNeonColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            
            <RadioButton
                android:id="@+id/rbNeonBlue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أزرق"
                android:textColor="#FFFFFF"
                android:buttonTint="#00D4FF"
                android:checked="true"
                android:layout_marginEnd="16dp"/>
                
            <RadioButton
                android:id="@+id/rbNeonPink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="وردي"
                android:textColor="#FFFFFF"
                android:buttonTint="#FF00FF"
                android:layout_marginEnd="16dp"/>
                
            <RadioButton
                android:id="@+id/rbNeonGreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أخضر"
                android:textColor="#FFFFFF"
                android:buttonTint="#00FF00" />
        </RadioGroup>

        <RadioGroup
            android:id="@+id/rgFrameStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbStyleCyber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حاد (سيبراني)"
                android:textColor="#FFFFFF"
                android:buttonTint="#00D4FF"
                android:checked="true"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/rbStyleRounded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="دائري (كلاسيكي)"
                android:textColor="#FFFFFF"
                android:buttonTint="#00D4FF" />
        </RadioGroup>

        <Button
            android:id="@+id/btnSaveSelectionStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ تخصيص شريط التحديد"
            android:backgroundTint="#00D4FF"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إعدادات المظهر"
            android:textColor="#00D4FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Spinner
            android:id="@+id/languageSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#00D4FF" />

        <Button
            android:id="@+id/btnApplyLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="تطبيق اللغة"
            android:backgroundTint="#00D4FF"
            android:textColor="#000000" />

        <RadioGroup
            android:id="@+id/backgroundGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <RadioButton android:id="@+id/rbDark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="داكن (افتراضي)" android:textColor="#FFFFFF" />
            <RadioButton android:id="@+id/rbLight" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فاتح (أبيض)" android:textColor="#FFFFFF" />
            <RadioButton android:id="@+id/rbCyber" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="سايبربانك (أخضر)" android:textColor="#00FF00" />
        </RadioGroup>

        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="اختيار صورة من المعرض"
            android:backgroundTint="#2A2A2A"
            android:textColor="#00FF00" />

        <Button
            android:id="@+id/btnSaveColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="حفظ اللون وتطبيقه"
            android:backgroundTint="#00FF00"
            android:textColor="#000000"
            android:textStyle="bold" />

        <!-- 4. قسم الأدوات السيادية -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الأدوات السيادية"
            android:textColor="#00D4FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchFloatingBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تشغيل الفقاعة العائمة (فوق التطبيقات الأخرى)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="16dp"
            android:background="#1E1E1E"
            app:thumbTint="#FFFFFF"
            app:trackTint="#00D4FF" />

        <Button
            android:id="@+id/btnAllowAutoStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="السماح بالتشغيل التلقائي (ضروري للاستقرار)"
            android:backgroundTint="#FFAA00"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- *** زرار تفعيل خدمة أزرار الصوت *** -->
        <Button
            android:id="@+id/btnEnableVolumeService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تفعيل اختصار أزرار الصوت (لقطة سريعة)"
            android:backgroundTint="#800080"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>

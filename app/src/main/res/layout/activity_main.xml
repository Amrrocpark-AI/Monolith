<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <!-- 1. الشريط العلوي النحيف -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- أيقونة المجلد والمعرض في أعلى اليسار (تم تحديث الاسم) -->
        <ImageButton
            android:id="@+id/btnGalleryTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_folder_top"
            app:tint="#00D4FF" />

        <!-- اسم التطبيق (وسط) -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="M O N O L I T H"
            android:textColor="#00D4FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:gravity="center"/>

        <!-- أيقونة الدردشة الذكية (يمين) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAIChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#111111"
            app:strokeColor="#00D4FF"
            app:strokeWidth="1dp"
            app:rippleColor="#3300D4FF">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#00D4FF" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- 2. شبكة الأدوات (المركز) -->
    <GridLayout
        android:id="@+id/toolsGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@+id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. استوديو الصور (فوتوشوب) -->
        <LinearLayout
            android:id="@+id/btnImageStudio"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_margin="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="40dp"
                app:cardBackgroundColor="#151515"
                app:strokeColor="#00D4FF"
                app:strokeWidth="1dp"
                app:rippleColor="#3300D4FF"
                app:cardElevation="8dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_crop"
                    app:tint="#00D4FF" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="استوديو الصور"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- 2. محرر النصوص -->
        <LinearLayout
            android:id="@+id/btnTextEditor"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_margin="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="40dp"
                app:cardBackgroundColor="#151515"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:rippleColor="#33FFFFFF"
                app:cardElevation="8dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="محرر النصوص"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- 3. الإعدادات -->
        <LinearLayout
            android:id="@+id/btnSettings"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_margin="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="40dp"
                app:cardBackgroundColor="#151515"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:rippleColor="#33FFFFFF"
                app:cardElevation="8dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="#FFFFFF" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الإعدادات"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

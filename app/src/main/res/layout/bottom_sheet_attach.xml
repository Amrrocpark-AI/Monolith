<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="خيارات الإرفاق والبحث"
        android:textColor="#00FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/btnOptionImage"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="▣  اختيار صورة من المعرض"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:background="#2A2A2A"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/btnOptionDocument"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="🗎  اختيار مستند (TXT / PDF)"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:background="#2A2A2A"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/btnOptionAudio"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="⌁  اختيار ملف صوتي"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:background="#2A2A2A"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/btnOptionSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="⌕  بحث شامل في ملفات الهاتف"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:background="#2A2A2A"
        android:layout_marginBottom="8dp"/>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/topBarVault"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVaultEditMode"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_vault_edit"
            app:tint="#D81B60" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="المحفوظات"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/btnVaultClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_custom"
            app:tint="#333333" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVault"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/topBarVault"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- الشريط السفلي العائم -->
    <LinearLayout
        android:id="@+id/layoutVaultActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/vault_bottom_bar_bg"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- زر حفظ التعديلات -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginStart="24dp">
            <ImageButton
                android:id="@+id/btnVaultConfirm"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_dark"
                android:src="@drawable/ic_vault_confirm"
                app:tint="#4CAF50" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="حفظ التعديلات"
                android:textColor="#A0A0A0"
                android:textSize="10sp"/>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- زر المشاركة (الوسط) -->
        <ImageButton
            android:id="@+id/btnVaultShare"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/vault_share_bg"
            android:elevation="8dp"
            android:src="@drawable/ic_vault_share"
            app:tint="#333333" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- زر تراجع -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginEnd="24dp">
            <ImageButton
                android:id="@+id/btnVaultUndo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_dark"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="تراجع"
                android:textColor="#A0A0A0"
                android:textSize="10sp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

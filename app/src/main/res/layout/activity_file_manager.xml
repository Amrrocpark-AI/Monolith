<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <!-- 1. الشريط العلوي العادي -->
    <LinearLayout
        android:id="@+id/topBarFileManager"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackFileManager"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#00D4FF" />

        <TextView
            android:id="@+id/tvPathTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مركز الملفات"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            android:singleLine="true"
            android:ellipsize="start"/>

        <ImageButton
            android:id="@+id/btnSort"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 2. شريط التحديد العلوي -->
    <LinearLayout
        android:id="@+id/topBarSelection"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#111111"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnCancelSelection"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FF0000" />

        <TextView
            android:id="@+id/tvSelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تم تحديد 0 عنصر"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginStart="12dp"/>
            
        <ImageButton
            android:id="@+id/btnSelectAll"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="#00D4FF" />

        <ImageButton
            android:id="@+id/btnZipSelected"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_save"
            app:tint="#00D4FF" />
    </LinearLayout>

    <!-- 3. شريط البحث -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="25dp"
        app:cardBackgroundColor="#1A1A1A"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@+id/topBarFileManager">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#666666" />

            <EditText
                android:id="@+id/etSearchFiles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="البحث في الملفات والصور..."
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. شريط التبويبات -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#0A0A0A"
        app:tabIndicatorColor="#00D4FF"
        app:tabSelectedTextColor="#00D4FF"
        app:tabTextColor="#666666"
        app:layout_constraintTop_toBottomOf="@+id/searchCard">
        <com.google.android.material.tabs.TabItem android:text="الملفات" />
        <com.google.android.material.tabs.TabItem android:text="المعرض" />
        <com.google.android.material.tabs.TabItem android:text="الألبومات" />
    </com.google.android.material.tabs.TabLayout>

    <!-- 5. *** قسم ملفاتي المثبتة (Pinned Albums) *** -->
    <LinearLayout
        android:id="@+id/pinnedAlbumsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tabLayoutFiles">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ملفاتي"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 1. زر الإضافة (+) -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="8dp" android:layout_marginEnd="4dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="72dp" android:layout_height="72dp" app:cardCornerRadius="36dp" app:cardBackgroundColor="#1A1A1A" app:strokeColor="#333333" app:strokeWidth="1dp" app:cardElevation="0dp" app:rippleColor="#3300D4FF">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@android:drawable/ic_input_add" app:tint="#00D4FF" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="جديد" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- 2. المفضلة -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="8dp" android:layout_marginEnd="4dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="72dp" android:layout_height="72dp" app:cardCornerRadius="36dp" app:cardBackgroundColor="#1A1A1A" app:strokeColor="#333333" app:strokeWidth="1dp" app:cardElevation="0dp" app:rippleColor="#3300D4FF">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@android:drawable/star_on" app:tint="#FFFFFF" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المفضلة" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- 3. لقطات الشاشة -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="8dp" android:layout_marginEnd="4dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="72dp" android:layout_height="72dp" app:cardCornerRadius="36dp" app:cardBackgroundColor="#1A1A1A" app:strokeColor="#333333" app:strokeWidth="1dp" app:cardElevation="0dp" app:rippleColor="#3300D4FF">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_camera" app:tint="#FFFFFF" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="لقطات الشاشة" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- 4. المهملات -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="8dp" android:layout_marginEnd="4dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="72dp" android:layout_height="72dp" app:cardCornerRadius="36dp" app:cardBackgroundColor="#1A1A1A" app:strokeColor="#333333" app:strokeWidth="1dp" app:cardElevation="0dp" app:rippleColor="#3300D4FF">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_delete" app:tint="#FF4444" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المهملات" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginTop="8dp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 6. قائمة الملفات (تم تعديلها لتنسدل تحت قسم ملفاتي) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toBottomOf="@+id/pinnedAlbumsSection"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 7. الزر العائم -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateFolder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#00D4FF"
        app:tint="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 8. الشريط السفلي السيادي -->
    <LinearLayout
        android:id="@+id/bottomSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/selection_actions_bg"
        android:paddingVertical="12dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:id="@+id/actionDelete" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_delete" app:tint="#FF4444" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="حذف" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/actionShare" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/ivActionShare" android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_share" app:tint="#00D4FF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إرسال" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/actionMove" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_save" app:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="نقل" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/actionCopy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_add" app:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="نسخ" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/actionAddAlbum" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/ivActionAlbum" android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_gallery" app:tint="#00D4FF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ألبوم" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/monolith_bg_chat"
    android:fitsSystemWindows="true">

    <!-- TOP TOOLBAR -->

    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/monolith_toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/monolith_bg_toolbar">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/monolith_ic_close"
            android:rotation="45"
            android:contentDescription="Back"
            android:padding="12dp"
            android:tint="@color/monolith_text"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MONOLITH"
                android:textColor="@color/monolith_text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTJ-S  •  INTELLIGENCE SYSTEM"
                android:textColor="@color/monolith_accent"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:includeFontPadding="false" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDashboard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/monolith_ic_more"
            android:contentDescription="Dashboard"
            android:padding="12dp"
            android:tint="@color/monolith_text_secondary"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/monolith_ic_more"
            android:contentDescription="Settings"
            android:padding="12dp"
            android:tint="@color/monolith_accent"
            android:scaleType="centerInside" />

    </LinearLayout>

    <!-- ACTIVE ENGINE -->

    <LinearLayout
        android:id="@+id/modelControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE INTELLIGENCE"
                android:textColor="@color/monolith_text_secondary"
                android:textSize="9sp"
                android:letterSpacing="0.1"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/modelSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local AI Engine  ▾"
                android:textColor="@color/monolith_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:background="@drawable/monolith_bg_input">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="#42D6C5" />

            <TextView
                android:id="@+id/tvEngineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" READY"
                android:textColor="@color/monolith_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- CURRENT CONVERSATION / HISTORY TOGGLE -->

    <LinearLayout
        android:id="@+id/conversationHistoryStrip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/tvCurrentConversation"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:background="@drawable/monolith_bg_input"
            android:text="Current Conversation"
            android:textColor="@color/monolith_text"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvHistoryLabel"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/monolith_bg_input"
            android:text="⌄"
            android:textColor="@color/monolith_accent"
            android:textSize="20sp"
            android:contentDescription="Open conversation history"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/monolith_accent" />

    </LinearLayout>

    <!-- CHAT AREA + FLOATING HISTORY -->

    <FrameLayout
        android:id="@+id/chatContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical"
            android:descendantFocusability="afterDescendants" />

        <!-- FLOATING CONVERSATION HISTORY -->

        <LinearLayout
            android:id="@+id/conversationHistoryPopup"
            android:layout_width="288dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="14dp"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:background="@drawable/monolith_bg_toolbar"
            android:elevation="12dp"
            android:visibility="gone"
            android:clipToPadding="false">

            <!-- POPUP HEADER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CONVERSATIONS"
                    android:textColor="@color/monolith_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/btnCreateConversation"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/monolith_accent"
                    android:textSize="23sp"
                    android:contentDescription="New conversation"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@color/monolith_text_secondary"
                android:alpha="0.20" />

            <!-- DYNAMIC CONVERSATION ITEMS -->

            <ScrollView
                android:id="@+id/conversationHistoryScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical"
                android:fadingEdge="vertical"
                android:fadingEdgeLength="16dp">

                <LinearLayout
                    android:id="@+id/conversationHistoryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

            </ScrollView>

            <!-- EMPTY HISTORY MESSAGE -->

            <TextView
                android:id="@+id/tvEmptyConversationHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:gravity="center"
                android:text="No previous conversations"
                android:textColor="@color/monolith_text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

    <!-- QUICK ACTIONS -->

    <HorizontalScrollView
        android:id="@+id/suggestionsScroll"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:scrollbars="none"
        android:fillViewport="false"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/suggestionsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/btnSuggestionAnalyze"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/monolith_bg_input"
                android:text="Analyze"
                android:textColor="@color/monolith_text_secondary"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btnSuggestionCode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/monolith_bg_input"
                android:text="Programming"
                android:textColor="@color/monolith_text_secondary"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btnSuggestionVision"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/monolith_bg_input"
                android:text="Vision"
                android:textColor="@color/monolith_text_secondary"
                android:textSize="11sp"
                android:maxLines="1" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- IMAGE PREVIEW -->

    <LinearLayout
        android:id="@+id/imagePreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/previewListContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

    </LinearLayout>

    <!-- MESSAGE COMPOSER -->

    <LinearLayout
        android:id="@+id/composerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="8dp"
        android:background="@drawable/monolith_bg_toolbar">

        <LinearLayout
            android:id="@+id/messageComposer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/monolith_input_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:background="@drawable/monolith_bg_input">

            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/monolith_ic_attach"
                android:contentDescription="Attach file"
                android:padding="12dp"
                android:tint="@color/monolith_text_secondary"
                android:scaleType="centerInside" />

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:maxHeight="120dp"
                android:maxLines="4"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:hint="Message INTJ-S..."
                android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="actionSend"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/monolith_text"
                android:textColorHint="@color/monolith_text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans"
                android:autofillHints="none"
                android:scrollbars="vertical" />

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/monolith_ic_mic"
                android:contentDescription="Voice input"
                android:padding="12dp"
                android:tint="@color/monolith_accent"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/monolith_bg_send"
                android:src="@drawable/monolith_ic_send"
                android:contentDescription="Send message"
                android:padding="11dp"
                android:tint="#FFFFFFFF"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- STATUS FOOTER -->

        <LinearLayout
            android:id="@+id/composerFooter"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tvPrivacyStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="INTJ-S  •  LOCAL-FIRST"
                android:textColor="@color/monolith_text_secondary"
                android:textSize="9sp"
                android:letterSpacing="0.04"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvComposerInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI ENGINE"
                android:textColor="@color/monolith_accent"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:maxLines="1" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
